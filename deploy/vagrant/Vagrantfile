# Tier-1 substrate VM: Ubuntu 24.04 under VirtualBox with NESTED VT-x, so
# /dev/kvm is real inside the guest. This is the reproducible replacement
# for the WSL2 path (plan §8) — a full kernel with the openvswitch module
# and genuine systemd.
#
#   cd deploy/vagrant
#   vagrant up            # provisions substrate + copies the repo in
#   vagrant ssh           # you are the `vagrant` service user
#   cd ~/vm-control-plane && ./scripts/spike/spike.sh
#
# Requires Hyper-V OFF on the Windows host (VirtualBox needs raw VT-x to
# offer nested virtualization). Verified off on the dev machine.

Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"
  config.vm.hostname = "vmc-substrate"

  # The repo is synced read-only-ish for a one-time copy into the VM's own
  # filesystem; nothing is BUILT or RUN from the shared mount (host-setup.sh
  # rejects /vagrant and /media/sf_ paths).
  config.vm.synced_folder "../..", "/repo", type: "virtualbox"

  config.vm.provider "virtualbox" do |vb|
    vb.name = "vmc-substrate"
    vb.memory = 16384
    vb.cpus = 8
    # THE load-bearing flag: without nested hardware virt, /dev/kvm never
    # appears and the spike is an immediate NO-GO.
    vb.customize ["modifyvm", :id, "--nested-hw-virt", "on"]
    vb.customize ["modifyvm", :id, "--ioapic", "on"]
    vb.customize ["modifyvm", :id, "--pae", "on"]
    # Nested-virt stability: expose the KVM paravirt clock to this Ubuntu guest
    # (steadier timekeeping under virtualization) and turn large pages off. Both
    # cut down on the flakiness VirtualBox's experimental nested VT-x can show.
    vb.customize ["modifyvm", :id, "--paravirtprovider", "kvm"]
    vb.customize ["modifyvm", :id, "--large-pages", "off"]
    vb.customize ["modifyvm", :id, "--graphicscontroller", "vmsvga"]
  end

  # Grow the root disk so cloud images + overlays fit.

  config.vm.provision "shell", path: "provision.sh", privileged: true
  config.vm.provision "shell",
    path: "copy-repo.sh",
    privileged: false # run as the `vagrant` service user
end
