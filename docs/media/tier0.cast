{"version": 2, "width": 108, "height": 26, "timestamp": 1786598446, "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}}
[0.015389, "o", "\r\n\u001b[1;36m# Tier 0: no hypervisor, fake drivers. Start the stack.\u001b[0m\r\n"]
[11.386029, "o", "\u001b[1;32m$ export VMCTL_SERVER=127.0.0.1:34353\u001b[0m\r\n"]
[12.394093, "o", "\r\n\u001b[1;36m# Create a VM. It returns an async operation.\u001b[0m\r\n"]
[13.397823, "o", "\u001b[1;32m$ bin/vmctl create vm demo-1 --cpu 2 --memory 2GiB\u001b[0m\r\n"]
[13.439511, "o", "idempotency-key: bfffc3a3-9911-421c-9b36-620870fa9616  (replay with --idempotency-key on ambiguous failures)\r\nOPERATION                             VERB    RESOURCE   STATE    TARGET-REV  ERROR\r\na3a21e02-9f7b-4253-803e-8ea758a1db7c  CREATE  vm/demo-1  PENDING  1           \r\n"]
[15.465446, "o", "\r\n"]
[15.470221, "o", "\u001b[1;36m# Wait for the operation, then list. REVISION is applied/desired.\u001b[0m\r\n"]
[16.476225, "o", "\u001b[1;32m$ bin/vmctl op wait a3a21e02-9f7b-4253-803e-8ea758a1db7c\u001b[0m\r\n"]
[16.510539, "o", "OPERATION                             VERB    RESOURCE   STATE  TARGET-REV  ERROR\r\na3a21e02-9f7b-4253-803e-8ea758a1db7c  CREATE  vm/demo-1  DONE   1           \r\n"]
[17.529531, "o", "\u001b[1;32m$ bin/vmctl list vms\u001b[0m\r\n"]
[17.563425, "o", "NAME    PHASE    NODE    EPOCH  CPU  MEMORY  IMAGE         REVISION\r\ndemo-1  RUNNING  node-a  1      2    2GiB    ubuntu-24.04  1/1\r\n"]
[19.578503, "o", "\r\n\u001b[1;36m# Stop it. Power is the mutable part of the spec.\u001b[0m\r\n"]
[20.592619, "o", "\u001b[1;32m$ bin/vmctl stop vm demo-1\u001b[0m"]
[20.593648, "o", "\r\n"]
[20.652753, "o", "OPERATION                             VERB          RESOURCE   STATE    TARGET-REV  ERROR\r\n3e875460-6946-4f19-8849-e13e722892f4  UPDATE_POWER  vm/demo-1  PENDING  2           \r\n"]
[21.930496, "o", "\u001b[1;32m$ bin/vmctl list vms\u001b[0m\r\n"]
[21.964557, "o", "NAME    PHASE    NODE    EPOCH  CPU  MEMORY  IMAGE         REVISION\r\ndemo-1  STOPPED  node-a  1      2    2GiB    ubuntu-24.04  2/2\r\n"]
[23.981361, "o", "\r\n\u001b[1;36m# Delete it: tombstone, reconciled teardown, finalize.\u001b[0m\r\n"]
[25.002704, "o", "\u001b[1;32m$ bin/vmctl delete vm demo-1\u001b[0m\r\n"]
[25.048821, "o", "OPERATION                             VERB    RESOURCE   STATE    TARGET-REV  ERROR\r\n56d5ee90-1a52-4eaa-bc26-ce80c816ded7  DELETE  vm/demo-1  PENDING  3           \r\n"]
[25.061528, "o", "\u001b[1;32m$ bin/vmctl op wait 56d5ee90-1a52-4eaa-bc26-ce80c816ded7\u001b[0m\r\n"]
[25.705747, "o", "OPERATION                             VERB    RESOURCE   STATE  TARGET-REV  ERROR\r\n56d5ee90-1a52-4eaa-bc26-ce80c816ded7  DELETE  vm/demo-1  DONE   3           \r\n"]
[26.719859, "o", "\u001b[1;32m$ bin/vmctl list vms\u001b[0m\r\n"]
[26.7742, "o", "NAME"]
[26.774666, "o", "  PHASE  NODE  EPOCH  CPU  MEMORY  IMAGE  REVISION\r\n"]
[28.795912, "o", "\r\n\u001b[1;36m# Tier 0 lifecycle complete.\u001b[0m\r\n"]
